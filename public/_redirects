# Cloudflare Pages Redirects
# Static files should be served directly (not through SPA)
# https://developers.cloudflare.com/pages/configuration/redirects/

# Serve static SEO files directly (200 = serve as-is)
/sitemap.xml        /sitemap.xml        200
/sitemap-articles.xml /sitemap-articles.xml 200
/robots.txt         /robots.txt         200
/llms.txt           /llms.txt           200
/ai.txt             /ai.txt             200
/humans.txt         /humans.txt         200
/manifest.json      /manifest.json      200
/favicon.svg        /favicon.svg        200
/sw.js              /sw.js              200

# Well-known directory
/.well-known/*      /.well-known/:splat 200

# SPA fallback - all other routes go to index.html
/*                  /index.html         200

