{
  // The prerender entry (src/entry-server.tsx) runs in Node at build time, so
  // it is checked with Node's types; the rest of src stays browser-only.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.ssr.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/entry-server.tsx", "src/vite-env.d.ts"],
  "exclude": []
}
