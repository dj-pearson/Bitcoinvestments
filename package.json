{
  "name": "bitcoin-investments",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy dist",
    "dev:wrangler": "npm run build && npx wrangler pages dev dist",
    "cf:deploy": "npx wrangler pages deploy dist --project-name=bitcoin-investments",
    "cf:tail": "npx wrangler pages deployment tail",
    "deploy:cron": "npx wrangler deploy --config wrangler-cron.toml",
    "cron:tail": "npx wrangler tail price-alerts-cron",
    "cron:test": "curl -X POST https://bitcoinvestments.net/api/check-price-alerts -H \"Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY\"",
    "deploy:newsletter": "npx wrangler deploy --config wrangler-newsletter.toml",
    "newsletter:tail": "npx wrangler tail weekly-newsletter-cron",
    "newsletter:test": "curl -X POST https://bitcoinvestments.net/api/send-newsletter -H \"Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY\"",
    "deploy:all": "npm run build && npm run cf:deploy && npm run deploy:cron && npm run deploy:newsletter",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^9.92.7",
    "@react-three/fiber": "^8.15.12",
    "@sentry/react": "^10.32.1",
    "@stripe/stripe-js": "^8.5.3",
    "@supabase/supabase-js": "^2.86.2",
    "@tanstack/react-query": "^5.56.2",
    "@tiptap/extension-character-count": "^3.18.0",
    "@tiptap/extension-code-block-lowlight": "^3.18.0",
    "@tiptap/extension-image": "^3.18.0",
    "@tiptap/extension-link": "^3.18.0",
    "@tiptap/extension-placeholder": "^3.18.0",
    "@tiptap/extension-youtube": "^3.18.0",
    "@tiptap/react": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "autoprefixer": "^10.4.22",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "framer-motion": "^12.23.26",
    "gsap": "^3.13.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.555.0",
    "maath": "^0.10.8",
    "postcss": "^8.5.26",
    "react": "18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.18",
    "three": "^0.160.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.57.0",
    "prettier": "^3.8.1",
    "terser": "^5.44.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.6"
  }
}
